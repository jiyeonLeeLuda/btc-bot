# ───────────────────────────────────────────────
# btc-bot 환경변수 템플릿
# 사용법:  cp .env.example .env   후 각 값을 채우세요.
# .env 는 .gitignore 에 있어 깃에 안 올라갑니다. 절대 키를 커밋하지 마세요.
# ───────────────────────────────────────────────

# [지금 작동] 디스코드 매매/장세 알림 웹훅 URL
# 디스코드 채널 → 설정(톱니) → 연동 → 웹훅 → 새 웹훅 → URL 복사
BTC_BOT_DISCORD_WEBHOOK=

# [실거래 코드 구현 후 사용] 바이낸스 API 키
# 바이낸스 → 프로필 → API 관리 → API 생성
# ⚠️ 권한: '현물 거래'만 켜고 '출금'은 반드시 끄세요. IP 화이트리스트 권장.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# [실거래 코드 구현 후 사용] 안전 스위치
# 테스트넷(가짜 돈)=true, 실제 거래소=false. 처음엔 반드시 true 로 시작.
BINANCE_TESTNET=true
# 실제 주문 허용 스위치. 명시적으로 1 로 바꾸기 전엔 주문이 나가지 않습니다.
BTC_BOT_LIVE=0
